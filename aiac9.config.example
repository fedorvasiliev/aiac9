# Скопируйте в ./aiac9.config, чтобы задать конфигурацию файлом вместо
# переменных окружения. Переменные окружения всегда перезаписывают
# значения из этого файла.

# Сколько последних запрос/ответ пар диалога держать активным контекстом
# на Шаге D (остальное — сжимается в summary или отбрасывается из
# контекста, см. HISTORY_SUMMARIZATION). По умолчанию: 20.
HISTORY_MSG_COUNT=20

# on/1/yes — включить суммаризацию: сообщения старше HISTORY_MSG_COUNT
# сжимаются LLM-запросом в dialog_summary и удаляются из таблицы dialog.
# off/0/no (по умолчанию) — старые сообщения просто не попадают в
# контекст, ничего не удаляется и не суммаризируется.
HISTORY_SUMMARIZATION=off

# Опционально: переопределяет логику HISTORY_SUMMARIZATION выше.
#   Sliding_Window — жёстко удалять сообщения старше HISTORY_MSG_COUNT,
#                    без суммаризации.
#   STICKY_FACTS   — извлекать факты (ключ-значение) из каждого запроса в
#                    таблицу facts и подмешивать их в контекст диалога.
# По умолчанию не задано — используется обычная логика выше.
# CONTEXT_STRATEGY=
